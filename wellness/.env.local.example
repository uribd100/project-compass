# Cloud sync is OPTIONAL — the app works fully offline without it.
# To enable sync between your phone and computer, create a free Supabase project
# (https://supabase.com), then copy your Project URL + anon key here and rename this
# file to ".env.local". See supabase/README.md for the full setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
